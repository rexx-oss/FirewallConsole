<Window x:Class="FirewallConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firewall Console (.NET 10)" 
        Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Icon="icon.png"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        Background="{DynamicResource BgBrush}">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="icon.png" Width="32" Height="32" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Firewall Console" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Auto-suppress unapproved allow rules • Drag &amp; drop EXE anywhere to create rules" 
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="ChkStartMinimized" Content="Start Minimized" Checked="ChkStartMinimized_Changed" Unchecked="ChkStartMinimized_Changed" 
                          Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="ModeToggleButton" Content="🛡 Mode: Whitelist (Strict)" Click="ModeToggle_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0"/>
                <Button Content="🌓 Theme" Click="ThemeToggle_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}"/>
            </StackPanel>
        </DockPanel>

        <!-- Action Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0" VerticalContentAlignment="Center" Padding="8,4" 
                         Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextPrimary}" 
                         BorderBrush="{DynamicResource BorderBrush}" TextChanged="SearchBox_TextChanged"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="➕ New Rule" Click="NewRule_Click" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                    <Button Content="✔ Approve" Click="Approve_Click" Background="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                    <Button Content="✖ Revoke" Click="Revoke_Click" Background="{DynamicResource DangerBrush}" Margin="0,0,6,0"/>
                    <Button Content="Enable" Click="Enable_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0"/>
                    <Button Content="Disable" Click="Disable_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0"/>
                    <Button Content="Allow/Block" Click="ToggleAction_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0"/>
                    <Button Content="🗑 Delete" Click="Delete_Click" Background="{DynamicResource DangerBrush}" Margin="0,0,6,0"/>
                    <Button Content="🔄 Refresh" Click="Refresh_Click" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inbound / Outbound Tabs -->
        <TabControl x:Name="RulesTabControl" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="RulesTabControl_SelectionChanged">
            <TabItem Header="Inbound Rules">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,8,0,0">
                    <DataGrid x:Name="InboundGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              Background="Transparent" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              BorderThickness="0" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding Enabled}" Width="55"/>
                            <DataGridTextColumn Header="Rule Name" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="70"/>
                            <DataGridTextColumn Header="Approved" Binding="{Binding IsApproved}" Width="75"/>
                            <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="60"/>
                            <DataGridTextColumn Header="Local Port" Binding="{Binding LocalPorts}" Width="90"/>
                            <DataGridTextColumn Header="Remote Port" Binding="{Binding RemotePorts}" Width="90"/>
                            <DataGridTextColumn Header="Program" Binding="{Binding ApplicationName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="Outbound Rules">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,8,0,0">
                    <DataGrid x:Name="OutboundGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              Background="Transparent" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              BorderThickness="0" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding Enabled}" Width="55"/>
                            <DataGridTextColumn Header="Rule Name" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="70"/>
                            <DataGridTextColumn Header="Approved" Binding="{Binding IsApproved}" Width="75"/>
                            <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="60"/>
                            <DataGridTextColumn Header="Local Port" Binding="{Binding LocalPorts}" Width="90"/>
                            <DataGridTextColumn Header="Remote Port" Binding="{Binding RemotePorts}" Width="90"/>
                            <DataGridTextColumn Header="Program" Binding="{Binding ApplicationName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Footer -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            <TextBlock x:Name="StatsLabel" Text="Rules: 0" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
        </DockPanel>
    </Grid>
</Window>
